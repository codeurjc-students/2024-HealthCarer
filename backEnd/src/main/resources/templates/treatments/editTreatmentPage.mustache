{{>header}}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-dark text-white text-center">
                    <h3>Editar tratamiento</h3>
                </div>
                <div class="card-body">
                    <form action="/treatments/edittreatment/{{id}}" method="POST">

                        <div class="form-group">
                            <label for="name">Nombre</label>
                            <input type="text" class="form-control" name="name" id="name" placeholder="Nombre" required value="{{treatment.name}}">
                        </div>

                        <div class="form-group">
                            <label for="startDate">Cambiar fecha de inicio</label>
                            <input type="date" class="form-control" name="startDate" id="startDate" placeholder="Fecha de inicio">
                            <label for="startTime">Cambiar hora de inicio</label>
                            <input type="time" class="form-control" name="startTime" id="startTime" placeholder="Hora de inicio">
                        </div>

                        <div class="form-group">
                            <label for="endDate">Cambiar fecha de fin</label>
                            <input type="date" class="form-control" name="endDate" id="endDate" placeholder="Fecha de fin">
                        </div>

                        <div class="form-group">
                            <label for="dispensingFrequency">Tiempo entre tomas</label>
                            <input type="number" class="form-control" name="dispensingFrequency" id="dispensingFrequency" placeholder="Tiempo entre tomas" required value="{{treatment.dispensingFrequency}}">
                        </div>

                        <div class="form-group">
                            <label for="medications">Medicamentos</label><br>
                            {{#medications}}
                                <label>
                                    {{name}}
                                    <input type="checkbox" name="medication" value="{{id}}" checked>
                                </label> <br>
                            {{/medications}}
                            {{#medicationsList}}
                                <label>
                                    {{name}}
                                    <input type="checkbox" name="medication" value="{{id}}">
                                </label> <br>
                            {{/medicationsList}}


                        </div>

                        <button type="submit" id="submit" class="btn btn-primary btn-block">Editar</button>
                    </form>

                    <div class="card mt-3">
                        <div class="card-body text-center">
                            <a href="/treatments/">Volver</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{>footer}}
